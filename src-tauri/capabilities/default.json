{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api-kanban.burdych.net/**" },
        { "url": "https://bproductive.burdych.net/**" },
        { "url": "http://localhost:*/**" }
      ]
    }
  ]
}
