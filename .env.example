# bProductive Self-Hosted Configuration
# Copy this file to .env and fill in the values

# ======================
# REQUIRED CONFIGURATION
# ======================

# Your site URL (where users access the app)
# Examples: http://localhost, https://kanban.example.com
SITE_URL=http://localhost

# Convex backend URL (for the frontend to connect to)
# Local: http://localhost:3210
# With reverse proxy: https://api.kanban.example.com
CONVEX_URL=http://localhost:3210

# Auth secret - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -base64 32
# (Legacy better-auth secret; kept only until the Convex Auth cutover is done.)
BETTER_AUTH_SECRET=change-me-in-production-use-openssl-rand

# ---- Convex Auth (migration to @convex-dev/auth) ----
# RS256 signing keys for Convex Auth JWTs, BASE64-encoded so the multi-line PEM
# and JSON survive env transport (deploy.sh decodes them). Generate:
#   node -e "import('jose').then(async j=>{const k=await j.generateKeyPair('RS256',{extractable:true});\
#   const pk=(await j.exportPKCS8(k.privateKey)).trim().replace(/\n/g,' ');\
#   const jwks=JSON.stringify({keys:[{use:'sig',...await j.exportJWK(k.publicKey)}]});\
#   console.log('JWT_PRIVATE_KEY_B64='+Buffer.from(pk).toString('base64'));\
#   console.log('JWKS_B64='+Buffer.from(jwks).toString('base64'))})"
# Put the REAL values in .env.migration (gitignored) and paste into Dokploy env.
JWT_PRIVATE_KEY_B64=
JWKS_B64=

# Stage-1 migration switch: "true" for ONE main deploy to copy existing
# better-auth password hashes into authAccounts. Leave false otherwise.
RUN_PASSWORD_MIGRATION=false

# ======================
# CONVEX SELF-HOSTED
# ======================

# Instance secret for Convex backend security
# Generate with: openssl rand -hex 32
INSTANCE_SECRET=change-me-generate-with-openssl-rand-hex-32

# Instance name (optional, defaults to "convex-self-hosted")
INSTANCE_NAME=convex-self-hosted

# Admin key for deploying Convex functions
# Generate AFTER starting the Convex backend:
#   docker compose exec convex ./generate_admin_key.sh
# The output looks like: convex-self-hosted|abc123...
# Copy the ENTIRE output including the prefix
ADMIN_KEY=

# ======================
# OPTIONAL CONFIGURATION
# ======================

# Additional trusted origins for CORS (comma-separated)
# Only needed if accessing from domains other than SITE_URL
# TRUSTED_ORIGINS=https://other-domain.com,https://another.com
