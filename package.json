  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:convex\" \"pnpm dev:app\"",
    "dev:convex": "convex dev --env-file .env.local",
    "dev:app": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "convex:deploy": "convex deploy",
    "tauri": "tauri",
    "build:mcp": "esbuild mcp/server.mjs --bundle --platform=node --format=esm --target=node18 --outfile=src-tauri/resources/bproductive-mcp.mjs",
    "dev:desktop": "pnpm build:mcp && tauri dev",
    "build:desktop": "pnpm build:mcp && tauri build",
    "dev:ios": "tauri ios dev",
    "build:ios": "APPLE_DEVELOPMENT_TEAM=9QY36KZ8JP tauri ios build --export-method release-testing",
    "ios:open": "tauri ios open"
  },
